AUTH_MODE=auto
# ============================================================================
# NORMAL DEPLOYMENT AND LOCAL WEB APP:
# AUTH_MODE=auto uses the current `az login` identity locally and managed
# identity when hosted in Azure. There is no separate AUTH_MODE=azure value.
# Leave AZURE_CLIENT_ID and AZURE_CLIENT_SECRET empty.
# "Client ID" and "Application ID" refer to the same Entra application value.
# Terraform creates and configures the deployed managed identities. The local
# Web App uses the current `az login` identity when AUTH_MODE=auto.
#
# OPTIONAL LOCAL CLIENT-SECRET AUTHENTICATION ONLY:
# Never deploy these values to Azure or commit a real secret.
# To opt in, set AUTH_MODE=client_secret and ALLOW_LOCAL_CLIENT_SECRET=true.
# Azure-hosted applications reject client_secret mode and must use managed identity.
# ============================================================================
ALLOW_LOCAL_CLIENT_SECRET=false
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
DEFENDER_API_BASE_URL=https://api.security.microsoft.com
AZURE_SUBSCRIPTION_ID=
AZURE_MANAGEMENT_GROUP_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=eastus
STORAGE_ACCOUNT_NAME=
STORAGE_CONTAINER_NAME=dvm-history
STORAGE_CURRENT_CONTAINER_NAME=dvm-current
# Normal deployment publishes live Defender data. Synthetic/combined modes are explicit evaluation options.
APP_MODE=live
SYNTHETIC_SEED=24017
SYNTHETIC_MONTHS=6
SYNTHETIC_DEVICE_COUNT=2500
RECOMMENDATION_ENRICHMENT_MODE=auto
ENABLE_EXPERIMENTAL_ENDPOINTS=false
FULL_ENRICHMENT_WEEKDAY=6
COLLECTION_SCHEDULE=0 0 5 * * *
# Normal collector + local Web App path reads the current live Azure bundle.
# Set to local only for the separate all-local evaluation path.
DASHBOARD_DATA_SOURCE=azure
DASHBOARD_STATIC_DIR=
DASHBOARD_CACHE_SECONDS=30
# Local Web App: false. Hosted Web App: Terraform sets true behind App Service Authentication.
DASHBOARD_AUTH_ENABLED=false
DASHBOARD_DATA_BROWSER_ENABLED=false
DASHBOARD_DATA_BROWSER_ROLE=
# Optional dashboard-only collaboration status. Not required for collection,
# lifecycle reporting, or remediation evidence. Leave false unless explicitly needed.
DASHBOARD_RECOMMENDATION_TRACKING_ENABLED=false
DASHBOARD_RECOMMENDATION_TRACKING_ROLE=Recommendation.Tracker
DASHBOARD_RECOMMENDATION_TRACKING_CONTAINER=dvm-workflow
