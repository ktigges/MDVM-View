AUTH_MODE=auto
# ============================================================================
# LOCAL DEVELOPMENT ONLY: optional client-secret authentication
# Never deploy these values to Azure or commit the real secret.
# To opt in, set AUTH_MODE=client_secret and ALLOW_LOCAL_CLIENT_SECRET=true.
# Azure-hosted applications reject client_secret mode and must use managed identity.
# ============================================================================
ALLOW_LOCAL_CLIENT_SECRET=false
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
DEFENDER_API_BASE_URL=https://api.security.microsoft.com
AZURE_SUBSCRIPTION_ID=
AZURE_MANAGEMENT_GROUP_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=eastus
STORAGE_ACCOUNT_NAME=
STORAGE_CONTAINER_NAME=dvm-history
STORAGE_CURRENT_CONTAINER_NAME=dvm-current
APP_MODE=synthetic
SYNTHETIC_SEED=24017
SYNTHETIC_MONTHS=6
SYNTHETIC_DEVICE_COUNT=2500
RECOMMENDATION_ENRICHMENT_MODE=auto
ENABLE_EXPERIMENTAL_ENDPOINTS=false
FULL_ENRICHMENT_WEEKDAY=6
COLLECTION_SCHEDULE=0 0 5 * * *
DASHBOARD_DATA_SOURCE=local
DASHBOARD_STATIC_DIR=
DASHBOARD_CACHE_SECONDS=30
# Leave false for local development. Enable only behind Azure App Service Authentication.
DASHBOARD_AUTH_ENABLED=false
DASHBOARD_DATA_BROWSER_ENABLED=false
DASHBOARD_DATA_BROWSER_ROLE=
DASHBOARD_RECOMMENDATION_TRACKING_ENABLED=false
DASHBOARD_RECOMMENDATION_TRACKING_ROLE=Recommendation.Tracker
DASHBOARD_RECOMMENDATION_TRACKING_CONTAINER=dvm-workflow
